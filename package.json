{
  "name": "divot.css",
  "version": "0.2.0",
  "description": "A simple skeuomorphic button style for a satisfying button experience.",
  "author": "Niko Lazaris",
  "homepage": "https://github.com/nlaz/divot.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlaz/divot.css.git"
  },
  "keywords": [
    "src",
    "button",
    "color-mix",
    "skeuomorphism",
    "bezel",
    "dark-mode"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "src/divot.css",
  "style": "src/divot.css",
  "exports": {
    ".": "./src/divot.css",
    "./divot.css": "./divot.css",
    "./tokens.css": "./src/tokens.css",
    "./core.css": "./src/core.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "divot.css",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  }
}
